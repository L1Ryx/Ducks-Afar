  m_Script: {fileID: 11500000, guid: 3467d0579a0c940a194cdf5dc73bd25e, type: 3}
  m_Name: Rest
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Sleep tight, everybody!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Don\u2019t scare me like that again, BUBBLES. And you too, CODA."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Yeah! ASTER\u2019s heart can\u2019t take it if you all do that!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: Shut it, TOFU. Speak for yourself.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "I\u2019m sorry for today, everyone."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "That\u2019s okay, CODA. We all need to rest now."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Good night!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  nextEncounter: {fileID: 0}
  onEncounterEnd: {fileID: 0}
