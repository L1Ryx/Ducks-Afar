    examineWidth: 1000
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - kind: 0
    speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: I'll be right here with you, Cap'n. Let's bring it home!
