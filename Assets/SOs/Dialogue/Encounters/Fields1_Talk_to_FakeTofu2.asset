  lines:
  - kind: 0
    speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: You found it, Cap'n. The untainted soil!
    examineImage: {fileID: 0}
    examineWidth: 1000
