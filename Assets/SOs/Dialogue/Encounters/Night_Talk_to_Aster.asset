  lines:
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "CODA has caused so much trouble today\u2026 I vote he sleeps on the haystack
      tonight!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Captain! You better not go easy on CODA when we find \u2018im!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Come back soon\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
