%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3467d0579a0c940a194cdf5dc73bd25e, type: 3}
  m_Name: Dusk_Ending
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: BUBBLES! There you are! How are you feeling?
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 11400000, guid: e98d4b93d5a5f4de1880b1a7690590f0, type: 2}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "It\u2019s so good to see everyone here! I\u2019m feeling much better now
      that I can see all of your lovely feathers!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Thank you for collecting so many hardworms for me :3 I was getting quite
      hungry.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: '!!!'
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Hmph, if you hadn\u2019t run off with Coda, I could have found even better
      hardworms for you."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: ' You always do find the best hardworms ASTER!'
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: And thank you, TOFU, for coming to find me!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Hey, where\u2019s my credit!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "This birdbrain couldn\u2019t have gotten anywhere if it weren\u2019t for
      my quick thinking!!!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: Honestly, they should promote me, hmph!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: Of course BUBBLES! Everyone on this team is super important!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Huhu~ ASTER even tried his best to search for the best hardworms\u2026
      but then it started getting dark~"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "Oh my! ASTER, I know how much you don\u2019t like the dark! Thanks for
      working so hard!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Hmph, at least BUBBLES knows when good work is done\u2026 I\u2019m sure
      that\u2019s why you knew you had to leave."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: BUBBLES! Where is CODA? ASTER said you were both gone when he woke up.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Why\u2019d that brute drag you out here anyways\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "Oh! Coda woke me up wayyyyyy earlier than you two\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "Hmmm, I wish he\u2019d been nicer about it\u2026 but he kept pecking at
      me to get up\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "I really wanted to wake everyone up! But CODA kept insisting we leave
      immediately\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "He kept quacking about how he found some sort of secret\u2026 some sort
      of secret to happiness for everyone back home."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Hmph! I\u2019ll straighten out your feathers right away after all of that
      brute\u2019s pecking!!!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Heh, thank you ASTER! Hmm honestly, that duck can be so confusing!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "I mean, aren\u2019t we already so happy and safe at the research station?"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Really, I mean we are positively just fine!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "But once we landed, I lost track of CODA\u2026 he seemed to be searching
      for something, and I couldn\u2019t keep up\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Hmm, you\u2019re right, BUBBLES, that is strange\u2026 what could CODA
      be looking for?"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Ahh! It\u2019s getting even darker! We should really start flying to scout
      out more places to find CODA!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: Yeah, he better have an explanation for us!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Who knows if he\u2019ll even speak\u2026 you never know what that duck
      is thinking\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "C\u2019mon Cap\u2019n! Let\u2019s see if we can find CODA before our nightly
      nap! To the ship!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  nextEncounter: {fileID: 0}
  onEncounterEnd: {fileID: 11400000, guid: be99eb3006b6048f083c103df9949a3b, type: 2}
