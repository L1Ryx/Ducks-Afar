%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3467d0579a0c940a194cdf5dc73bd25e, type: 3}
  m_Name: Weird_Talk_to_Aster
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "You\u2019re finally awake! It\u2019s urgent!!!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: EVERYONE is gone!!!!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "I just can\u2019t believe it. TOFU, BUBBLES, CODA, all three of them,
      GONE!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "I\u2019m sure TOFU had some seriously unprofessional leadership idea and
      dragged BUBBLES and CODA into it!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Ugh. BUBBLES is the only one that appreciates my hard work! We\u2019ve
      got to get \u2018im back!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "\u2026I guess the other two are important too\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "I say we head to the SOLARIS planet first. TOFU\u2019s always talking
      about taking a vacation there. Honestly, he never stops!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "C\u2019mon Captain! Take the keycard and let\u2019s go!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  nextEncounter: {fileID: 0}
  onEncounterEnd: {fileID: 11400000, guid: 7c4a54690bd0241ac951545f43856084, type: 2}
