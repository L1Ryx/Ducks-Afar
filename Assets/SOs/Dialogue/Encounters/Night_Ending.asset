%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3467d0579a0c940a194cdf5dc73bd25e, type: 3}
  m_Name: Night_Ending
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: CODA! Thank goodness you are alright!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Look at how much work you\u2019ve gone and made us do! You are definitely
      sleeping on the haystack tonight!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: What have you been up to, CODA? Were you looking for something?
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Hmph, our fearless leader always worrying about the wrong thing. Let\u2019s
      go home already!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: ASTER! Whatever it was, it must have been super important to CODA with
      all that pecking he did at my feathers to wake me up!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Didya find what you were looking for CODA?
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026don\u2019t remember."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "\u2026surely you must remember grabbing me out of my sleep?"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026the body greedily holds on, yet the mind is an ever evanescent plane\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: Hah?!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Hmm you must be real tired after all this adventuring, CODA! C\u2019mon,
      finish up your hardworms first!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: Thank you, TOFU.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026All I remember is waking up with a strange hunger."
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: When I regained my bearings, I was on this planet. Alone.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: Aha, but you definitely pecked me awake CODA!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: ...
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: I am sorry for that BUBBLES. I know you care for your feathers.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "But I truly don\u2019t remember anything between waking up and arriving
      here\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: bb231da6cad654c88939f84e4915d049, type: 2}
    text: "Well! Whatever\u2019s happened, the only thing that matters is that we
      have everyone! Which means that everything will be fine, no matter what!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 32dea8d7a505646f49b0574e65a098bc, type: 2}
    text: "Yeah! Who cares about some so-called secret to happiness! I\u2019ll be
      most happy when we\u2019re finally back home!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 1ad9eae3d845d4a84afdca72c5fbaa66, type: 2}
    text: "\u2026"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: Yes! The most important thing that we have is each other.
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Although, maybe we should have Cap\u2019n take a look at you when we get
      back, CODA! We can\u2019t have you losing your memories!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: Those are important!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: All aboard the ship, everyone! Our next stop, Home!
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 47384b603847b494cb22479fc827ed33, type: 2}
    text: "Take it away, Cap\u2019n!"
    lineCue: {fileID: 0}
    afterLineEvent: {fileID: 0}
  nextEncounter: {fileID: 0}
  onEncounterEnd: {fileID: 0}
